#!/usr/bin/env bash
# === RVPoint gem5 C++ Runner and Parser ===
# Usage: ./scripts/gem5run <cpp_file> [additional_gem5_options]
#
# Compiles a C++ source file statically for RISC-V, runs it in gem5 (Docker),
# and parses simulation performance metrics.

set -euo pipefail

# ─── Terminal colors ───────────────────────────────────────────────────────────
BOLD=$'\e[1m'
DIM=$'\e[2m'
GREEN=$'\e[32m'
RED=$'\e[31m'
CYAN=$'\e[36m'
YELLOW=$'\e[33m'
RESET=$'\e[0m'

divider() { echo "${DIM}────────────────────────────────────────────────────────────${RESET}"; }
header()  { echo ""; divider; echo "${BOLD}${CYAN}  $*${RESET}"; divider; }

# ─── Path resolution ──────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

source "$PROJECT_ROOT/env/activate.sh"
source "$PROJECT_ROOT/scripts/lib/common.sh"
BUILD_DIR="$(get_build_dir)"

# ─── Argument parsing ──────────────────────────────────────────────────────────
BACKEND="rvv"
CPP_FILE=""
STREAM_OUTPUT=false
SAVE_RESULTS=false
GEM5_EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)
      BACKEND="$2"
      shift 2
      ;;
    --scalar|--scaler|--normal)
      BACKEND="scalar"
      shift
      ;;
    --rvv)
      BACKEND="rvv"
      shift
      ;;
    -v|--verbose|--stream|--show-output)
      STREAM_OUTPUT=true
      shift
      ;;
    --save-results)
      SAVE_RESULTS=true
      shift
      ;;
    -h|--help)
      echo "Usage: $0 <cpp_file> [--backend rvv|scalar] [-v|--stream] [additional_gem5_options]"
      exit 0
      ;;
    *)
      if [[ -z "$CPP_FILE" && ! "$1" =~ ^- ]]; then
        CPP_FILE="$1"
      else
        GEM5_EXTRA_ARGS+=("$1")
      fi
      shift
      ;;
  esac
done

if [[ -z "$CPP_FILE" ]]; then
  echo "Usage: $0 <cpp_file> [--backend rvv|scalar] [--scalar] [--rvv] [additional_gem5_options]" >&2
  exit 1
fi

if [[ ! -f "$CPP_FILE" ]]; then
  echo "${RED}Error: File '$CPP_FILE' not found.${RESET}" >&2
  exit 1
fi

case "$BACKEND" in
  rvv)
    MARCH="rv64gcv"
    LIB_DIR="$BUILD_DIR/rvv"
    ;;
  scalar|riscv|normal)
    BACKEND="scalar"
    MARCH="rv64gc"
    LIB_DIR="$BUILD_DIR/scalar"
    ;;
  *)
    echo "${RED}Error: Unknown backend '$BACKEND'. Use 'rvv' or 'scalar'.${RESET}" >&2
    exit 1
    ;;
esac

BASE_NAME="$(basename "$CPP_FILE" .cpp)"
# gem5 always needs a real output dir for stats.txt; use a temp dir unless --save-results
if [[ "$SAVE_RESULTS" == "true" ]]; then
  OUTDIR="$PROJECT_ROOT/results/${BASE_NAME}_${BACKEND}_gem5run"
else
  # Must be inside BUILD_DIR — that volume IS mounted inside the Docker container
  OUTDIR="$(mktemp -d "$BUILD_DIR/gem5run_tmp.XXXXXX")"
fi
BIN_DIR="$BUILD_DIR/gem5run_bin"
mkdir -p "$BIN_DIR"
BIN_FILE="$BIN_DIR/${BASE_NAME}_${BACKEND}"

START_TIME=$(date +%s)

echo ""
echo "${BOLD}╔══════════════════════════════════════════════════════════╗${RESET}"
echo "${BOLD}║  gem5run  ·  $(date '+%Y-%m-%d %H:%M:%S')                         ║${RESET}"
echo "${BOLD}╚══════════════════════════════════════════════════════════╝${RESET}"
echo "  ${DIM}Source  :${RESET} $CPP_FILE"
echo "  ${DIM}Backend :${RESET} $BACKEND ($MARCH)"
echo "  ${DIM}Binary  :${RESET} $BIN_FILE"
echo ""

# ─── 1. Build library ─────────────────────────────────────────────────────────
header "1/3  Building rvvpcl library ($BACKEND)"
if ! BUILD_LOG="$("$PROJECT_ROOT/scripts/build.sh" --toolchain linux --backend "$BACKEND" 2>&1)"; then
  echo "$BUILD_LOG" | grep -E '(error|warning|Built target|Linking)' | sed 's/^/  /' || echo "$BUILD_LOG"
  echo "${RED}✗ Build failed.${RESET}" >&2
  exit 1
fi
echo "  ${GREEN}✓ Library up to date ($BACKEND)${RESET}"

# ─── 2. Compile test binary ───────────────────────────────────────────────────
header "2/3  Cross-compiling for RISC-V ($MARCH)"
riscv64-unknown-linux-gnu-g++ -static -O3 \
  -march="$MARCH" -mabi=lp64d \
  -I"$PROJECT_ROOT/src/include" \
  -L"$LIB_DIR" \
  "$CPP_FILE" -lrvvpcl \
  -o "$BIN_FILE"
echo "  ${GREEN}✓ Binary ready:${RESET} $BIN_FILE"

# ─── 3. Run gem5 simulation ───────────────────────────────────────────────────
header "3/3  Running gem5 simulation (Docker)"
echo ""

GEM5_EXIT=0
SIM_LOG="$(mktemp)"

(
  docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v "$PROJECT_ROOT:$PROJECT_ROOT" \
    -v "$BUILD_DIR:$BUILD_DIR" \
    -w "$PROJECT_ROOT" \
    manuel313/gem5_v25 \
    /gem5/build/RISCV/gem5.opt \
      -d "$OUTDIR" \
      /gem5/configs/deprecated/example/se.py \
      --cmd "$BIN_FILE" "${GEM5_EXTRA_ARGS[@]}" \
    > "$SIM_LOG" 2>&1
) &
GEM5_PID=$!

if [[ "$STREAM_OUTPUT" == "true" ]]; then
  echo "  ${DIM}Streaming simulation log output...${RESET}"
  tail -n +1 -f "$SIM_LOG" 2>/dev/null | grep --line-buffered -vE '^(warn:|info:|gem5 (Simulator|is |version|compiled|started|executing)|command line:|Global frequency)' | sed --unbuffered 's/^/  /' &
  STREAM_PID=$!
fi

ELAPSED_HUNDREDTHS=0
while kill -0 "$GEM5_PID" 2>/dev/null; do
  if [[ "$STREAM_OUTPUT" != "true" ]]; then
    MINS=$((ELAPSED_HUNDREDTHS / 6000))
    SECS=$(((ELAPSED_HUNDREDTHS % 6000) / 100))
    HUNDREDTHS=$((ELAPSED_HUNDREDTHS % 100))
    printf "\r  ${CYAN}⏳ Running gem5 simulation...${RESET} ${BOLD}%02d:%02d.%02d${RESET}" "$MINS" "$SECS" "$HUNDREDTHS"
  fi
  sleep 0.05
  ELAPSED_HUNDREDTHS=$((ELAPSED_HUNDREDTHS + 5))
done

if ! wait "$GEM5_PID"; then
  GEM5_EXIT=$?
fi

if [[ "$STREAM_OUTPUT" == "true" && -n "${STREAM_PID:-}" ]]; then
  kill "$STREAM_PID" 2>/dev/null || true
fi

MINS=$((ELAPSED_HUNDREDTHS / 6000))
SECS=$(((ELAPSED_HUNDREDTHS % 6000) / 100))
HUNDREDTHS=$((ELAPSED_HUNDREDTHS % 100))
if [[ "$STREAM_OUTPUT" != "true" ]]; then
  printf "\r  ${GREEN}✓ Simulation complete${RESET} ${DIM}(elapsed: %02d:%02d.%02ds)${RESET}\n\n" "$MINS" "$SECS" "$HUNDREDTHS"
else
  printf "\n  ${GREEN}✓ Simulation complete${RESET} ${DIM}(elapsed: %02d:%02d.%02ds)${RESET}\n\n" "$MINS" "$SECS" "$HUNDREDTHS"
fi

if [[ -f "$SIM_LOG" ]]; then
  grep -vE '^(warn:|info:|gem5 (Simulator|is |version|compiled|started|executing)|command line:|Global frequency)' "$SIM_LOG" \
    | sed 's/^/  /' || true
  rm -f "$SIM_LOG"
fi

# Remove temp gem5 output dir if not saving results
if [[ "$SAVE_RESULTS" != "true" && "$OUTDIR" == /tmp/gem5run.* ]]; then
  trap 'rm -rf "$OUTDIR"' EXIT
fi

END_TIME=$(date +%s)
WALL_TIME=$(( END_TIME - START_TIME ))

# ─── Result summary ───────────────────────────────────────────────────────────
# ─── Result summary & JSON generation ─────────────────────────────────────────
echo ""
divider

OUTPUT_JSON_DIR="$PROJECT_ROOT/output/gem5"
mkdir -p "$OUTPUT_JSON_DIR"
JSON_FILE="$OUTPUT_JSON_DIR/${BASE_NAME}_${BACKEND}.json"
STATS_FILE="$OUTDIR/stats.txt"

if [[ -f "$STATS_FILE" ]]; then
  awk -v cyan="$CYAN" -v reset="$RESET" -v bold="$BOLD" -v dim="$DIM" '
  $1 == "simSeconds"             { sim_sec = $2 }
  $1 == "hostSeconds"            { host_sec = $2 }
  $1 == "simInsts"               { insts = $2 }
  $1 == "system.cpu.numCycles"   { cycles = $2 }
  $1 == "system.cpu.cpi"         { cpi = $2 }
  $1 == "system.cpu.ipc"         { ipc = $2 }
  END {
    printf "\n%s  Simulation Metrics%s\n", bold, reset
    if (sim_sec && host_sec) {
      factor = host_sec / sim_sec
      printf "  %-28s %s%.6f s%s\n",  "Simulated CPU Time",      cyan, sim_sec,  reset
      printf "  %-28s %s%.2f s%s\n",  "Host Wall Time",           cyan, host_sec, reset
      printf "  %-28s %s%.2fx%s\n",   "Slowdown Factor",          cyan, factor,   reset
    }
    if (insts)  printf "  %-28s %s%d%s\n",      "Committed Instructions",  cyan, insts,  reset
    if (cycles) printf "  %-28s %s%d%s\n",      "Simulated Clock Cycles",  cyan, cycles, reset
    if (cpi)    printf "  %-28s %s%.4f%s\n",    "CPI",                     cyan, cpi,    reset
    if (ipc)    printf "  %-28s %s%.4f%s\n",    "IPC",                     cyan, ipc,    reset
    printf "\n"
  }
  ' "$STATS_FILE"

  python3 -c "
import sys, os, json, re
from datetime import datetime, timezone

stats_file, json_file, source_file, backend, march, bin_file, exit_code, wall_time = sys.argv[1:9]

metrics = {
    'metadata': {
        'source': source_file,
        'backend': backend,
        'arch': march,
        'binary': bin_file,
        'status': 'PASS' if exit_code == '0' else 'FAIL',
        'exit_code': int(exit_code),
        'wall_time_seconds': int(wall_time),
        'created_at': datetime.now(timezone.utc).isoformat()
    },
    'simulation': {},
    'cache': {},
    'branch_prediction': {},
    'op_classes': {}
}

pattern = re.compile(r'^\s*([a-zA-Z0-9_\.\:]+)\s+([\d\.\-]+|\bnan\b|\binf\b)')

if os.path.exists(stats_file):
    with open(stats_file, 'r') as f:
        for line in f:
            match = pattern.match(line)
            if not match:
                continue
            key, val = match.group(1), match.group(2)
            try:
                num_val = float(val) if '.' in val else int(val)
            except ValueError:
                continue

            if key == 'simSeconds':
                metrics['simulation']['sim_seconds'] = num_val
            elif key == 'hostSeconds':
                metrics['simulation']['host_seconds'] = num_val
            elif key in ('simInsts', 'system.cpu.simInsts'):
                metrics['simulation']['committed_instructions'] = int(num_val)
            elif key in ('system.cpu.numCycles', 'system.cpu.cycles'):
                metrics['simulation']['cycles'] = int(num_val)
            elif key == 'system.cpu.cpi':
                metrics['simulation']['cpi'] = num_val
            elif key == 'system.cpu.ipc':
                metrics['simulation']['ipc'] = num_val
            elif 'icache.overallHits' in key:
                metrics['cache']['icache_hits'] = int(num_val)
            elif 'icache.overallMisses' in key:
                metrics['cache']['icache_misses'] = int(num_val)
            elif 'dcache.overallHits' in key:
                metrics['cache']['dcache_hits'] = int(num_val)
            elif 'dcache.overallMisses' in key:
                metrics['cache']['dcache_misses'] = int(num_val)
            elif 'l2.overallHits' in key:
                metrics['cache']['l2_hits'] = int(num_val)
            elif 'l2.overallMisses' in key:
                metrics['cache']['l2_misses'] = int(num_val)
            elif 'branchPred.condPredicted' in key:
                metrics['branch_prediction']['cond_predicted'] = int(num_val)
            elif 'branchPred.condIncorrect' in key:
                metrics['branch_prediction']['cond_incorrect'] = int(num_val)
            elif 'opClass::' in key:
                op_cls = key.split('opClass::')[-1]
                if num_val > 0:
                    metrics['op_classes'][op_cls] = int(num_val)

if 'sim_seconds' in metrics['simulation'] and 'host_seconds' in metrics['simulation']:
    s = metrics['simulation']['sim_seconds']
    h = metrics['simulation']['host_seconds']
    if s > 0:
        metrics['simulation']['slowdown_factor'] = round(h / s, 2)

if 'cond_predicted' in metrics['branch_prediction'] and 'cond_incorrect' in metrics['branch_prediction']:
    p = metrics['branch_prediction']['cond_predicted']
    i = metrics['branch_prediction']['cond_incorrect']
    if p > 0:
        metrics['branch_prediction']['mispredict_rate'] = round(i / p, 4)

with open(json_file, 'w') as f:
    json.dump(metrics, f, indent=2)
" "$STATS_FILE" "$JSON_FILE" "$CPP_FILE" "$BACKEND" "$MARCH" "$BIN_FILE" "$GEM5_EXIT" "$WALL_TIME"

  echo "  ${GREEN}✓ Metrics saved to JSON:${RESET} $JSON_FILE"
fi

if [[ "${OUTPUT_JSON:-false}" == "true" ]]; then
  echo ""
  echo "${BOLD}JSON Metrics:${RESET}"
  cat "$JSON_FILE"
fi

divider
if [[ "$GEM5_EXIT" -eq 0 ]]; then
  echo "  ${GREEN}${BOLD}✓ PASS${RESET}  — simulation exited cleanly  ${DIM}(wall: ${WALL_TIME}s)${RESET}"
else
  echo "  ${RED}${BOLD}✗ FAIL${RESET}  — exit code ${GEM5_EXIT}  ${DIM}(wall: ${WALL_TIME}s)${RESET}"
fi
divider
echo ""
