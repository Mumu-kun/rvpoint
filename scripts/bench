#!/usr/bin/env bash
# ─── DEPRECATED ─────────────────────────────────────────────────────────────
# 'scripts/bench' is obsolete.
# Use './scripts/gem5run' for gem5 simulations or './scripts/run.sh' for QEMU/host.
# ─────────────────────────────────────────────────────────────────────────────

BOLD=$'\e[1m'
YELLOW=$'\e[33m'
CYAN=$'\e[36m'
RESET=$'\e[0m'

echo "${YELLOW}${BOLD}[DEPRECATED] 'scripts/bench' is obsolete.${RESET}"
