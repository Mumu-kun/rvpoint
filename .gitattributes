# Auto detect text files and perform LF normalization
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
Dockerfile text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

*.pcd binary
*.tar* binary
*.zip binary
